---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formUrl = 'https://www.chuhching.com/form/ai-collective-hr/partner';

const offers = [
  {
    name: 'Team Training',
    length: 'Four weeks, one session a week',
    items: [
      'The Ship It curriculum, built on your real work instead of a toy project',
      "Spread across the team so it doesn't live in one person's head",
      'Works from about three people up',
      'Ends with something your team built in front of a real user',
    ],
  },
  {
    name: 'Training, Then a Sprint',
    length: 'About six weeks',
    featured: true,
    items: [
      'Train the team first, then build the first workflow alongside them',
      'The fastest route from pilot to something running',
    ],
  },
  {
    name: 'Implementation Sprint',
    length: 'Usually two weeks',
    items: [
      'We build one working AI workflow in your business, start to finish',
      'Your team watches it get built and owns it afterward',
      "We tell you which parts shouldn't be automated before you spend money on them",
    ],
  },
];
---

<Layout title="Team Training | AI Collective Hampton Roads">
  <section class="page-header">
    <div class="container">
      <h1>Training for Your Team</h1>
      <p class="header-intro">Most teams have run an AI pilot and then stalled. We bring the curriculum we teach at the chapter in-house and run it against the work your team does every week. AI Collective Hampton Roads LLC delivers it on an invoice, and those fees help keep chapter events free.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pricing-grid">
        {offers.map((o) => (
          <div class={`pricing-card${o.featured ? ' featured' : ''}`}>
            <div class="pricing-header">
              <h3>{o.name}</h3>
              <div class="length">{o.length}</div>
            </div>
            <div class="pricing-body">
              <ul>
                {o.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title">Fixed price, scoped up front</h2>
      <p class="body-text">No hourly billing and no open-ended retainer. We scope the work on a call, give you one number, and that's what you pay. If what you need is a platform migration, a data engineering project, or another hire, we'll say so on that first call and point you to who does it.</p>
      <p class="body-text">For a public workshop with your company's name on it, book the Branded Workshop ($5,000) on our <a href={`${base}/partnerships`}>Partners</a> page.</p>
    </div>
  </section>

  <section class="section" id="menu">
    <div class="container">
      <div class="form-grid">
        <div class="form-copy">
          <h2 class="section-title">Get a scope and a price</h2>
          <p>Tell us what your team does and where it's stuck. We'll come back with a scope and a number.</p>
        </div>
        <div class="form-embed">
          <iframe src={formUrl} title="Request a scope from AI Collective Hampton Roads" loading="lazy"></iframe>
          <p class="form-fallback">Form not loading? <a href={formUrl} target="_blank" rel="noopener">Open it in a new tab</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--color-primary);
    padding: var(--spacing-xl) 0;
  }

  .page-header h1 {
    color: var(--color-white);
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: var(--spacing-sm);
  }

  .header-intro {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    max-width: 780px;
    line-height: 1.7;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    align-items: start;
  }

  .pricing-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s;
  }

  .pricing-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .pricing-card.featured {
    border: 2px solid var(--color-primary);
  }

  .pricing-card.featured .pricing-header {
    background: linear-gradient(135deg, #D4742C, #E8943A);
  }

  .pricing-card.featured .pricing-header h3,
  .pricing-card.featured .pricing-header .length {
    color: var(--color-white);
  }

  .pricing-header {
    padding: var(--spacing-lg);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .pricing-header h3 {
    font-size: 1.35rem;
    margin-bottom: var(--spacing-xs);
  }

  .length {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .pricing-body {
    padding: var(--spacing-lg);
  }

  .pricing-body ul {
    list-style: none;
    padding: 0;
  }

  .pricing-body ul li {
    padding: 0.375rem 0 0.375rem 1.25rem;
    font-size: 0.95rem;
    color: var(--color-text);
    position: relative;
  }

  .pricing-body ul li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .narrow {
    max-width: 820px;
  }

  .body-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--spacing-2xl);
    align-items: start;
  }

  .form-copy p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  .form-embed {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--spacing-sm);
    box-shadow: var(--shadow-sm);
  }

  .form-embed iframe {
    width: 100%;
    height: 1240px;
    border: 0;
    border-radius: 8px;
    background: white;
  }

  .form-fallback {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-top: var(--spacing-sm);
    text-align: center;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .pricing-grid,
    .form-grid {
      grid-template-columns: 1fr;
    }

    .form-grid {
      gap: var(--spacing-lg);
    }

    .form-embed iframe {
      height: 1340px;
    }
  }
</style>
