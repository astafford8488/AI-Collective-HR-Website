---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formUrl = 'https://www.chuhching.com/form/ai-collective-hr/partner';

const packages = [
  {
    name: 'Annual Partner',
    price: '$4,999',
    priceNote: 'per year',
    items: [
      'Named chapter partner at every Build and Demo Night and study group for 12 months',
      'Your logo and link on event listings and event slides',
      'A thank-you by name from the front of the room at each event',
      "Post your open roles in the chapter's online community",
      "First pick of the year's six workshop and hackathon dates",
    ],
  },
  {
    name: 'Branded Workshop',
    price: '$5,000',
    priceNote: '2 for $9,000 · 3 for $12,000',
    featured: true,
    items: [
      'A hands-on AI workshop presented by your company',
      'We write the curriculum, teach it, and run the room',
      'Listed on Meetup, Luma, Eventbrite, Facebook, and LinkedIn',
      'At least 50 attendees, filled through paid ads and the chapter list',
      'Headcount and photos afterward',
    ],
  },
  {
    name: 'Campus Hackathon',
    price: '$20,000',
    priceNote: 'per event',
    items: [
      'A focused build event on a campus or at a venue you host',
      'One challenge track, designed with you',
      'We recruit the builders, mentor the teams, and judge the projects',
      'Your company billed as presenting sponsor',
      'Every finished project handed to you',
    ],
  },
  {
    name: 'Full Hackathon',
    price: '$50,000',
    priceNote: 'per event',
    items: [
      'Several challenge tracks, scoped with your team',
      'We find the venue, recruit builders from well beyond Hampton Roads, and run every hour of it',
      'Mentors on the floor and a judging panel you help pick',
      'Presenting-sponsor billing on everything we publish',
      'A written report afterward with the winning projects and the people who built them',
    ],
  },
];
---

<Layout title="Partner With the Chapter | AI Collective Hampton Roads">
  <section class="page-header">
    <div class="container">
      <h1>Partner With the Chapter</h1>
      <p class="header-intro">Every Build and Demo Night and study group we run is free to attend. Partners are the reason it stays that way. Most partners pick one of the packages below. Others host a room, feed a crowd, or send a speaker, and that keeps the lights on too.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Packages and Prices</h2>
      <p class="section-subtitle">Four fixed packages. We run six workshops and hackathons a year in total, because six is the number we deliver well. Anything past six gets quoted separately, at a higher price.</p>
      <div class="pricing-grid">
        {packages.map((p) => (
          <div class={`pricing-card${p.featured ? ' featured' : ''}`}>
            <div class="pricing-header">
              <h3>{p.name}</h3>
              <div class="price">{p.price}</div>
              <div class="price-note">{p.priceNote}</div>
            </div>
            <div class="pricing-body">
              <ul>
                {p.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">How Billing Works</h2>
      <ul class="terms-list">
        <li>You don't need an annual partnership to book a workshop or a hackathon.</li>
        <li>We bill by invoice. It's a commercial agreement, not a donation, and chapter events stay free for everyone.</li>
        <li>We never sell or share attendee data. Sponsors get the headcount, not the guest list.</li>
        <li>Private training for your own staff, or a smaller room, is a different product. It's covered on our <a href={`${base}/workshops`}>Team Training</a> page.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Ways to Support</h2>
      <p class="section-subtitle">Money helps. So does a venue, a speaker, or a stack of job leads for our builders.</p>
      <div class="needs-grid">
        <div class="card need-card">
          <div class="need-icon"><Icon name="calendar" size={28} /></div>
          <h3>Event Logistics and Hospitality</h3>
          <p>Food and drinks, signage, photo backdrops, name badges, chapter swag</p>
        </div>
        <div class="card need-card">
          <div class="need-icon"><Icon name="megaphone" size={28} /></div>
          <h3>Visibility and Community Growth</h3>
          <p>Speaker referrals, workshop facilitation, photography, social amplification, event space</p>
        </div>
        <div class="card need-card">
          <div class="need-icon"><Icon name="code" size={28} /></div>
          <h3>Tech Tools and Career Development</h3>
          <p>Tool and subscription donations, job and internship leads, resume nights, grants</p>
        </div>
        <div class="card need-card">
          <div class="need-icon"><Icon name="wallet" size={28} /></div>
          <h3>Financial Support and Infrastructure</h3>
          <p>Paid packages, speaker fees, storage, professional services, grant support</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="contact">
    <div class="container">
      <div class="form-grid">
        <div class="form-copy">
          <h2 class="section-title">Start the conversation</h2>
          <p>Pick a package or describe the event you want. One of the chapter leads will write back with dates and next steps.</p>
        </div>
        <div class="form-embed">
          <iframe src={formUrl} title="Partner with AI Collective Hampton Roads" loading="lazy"></iframe>
          <p class="form-fallback">Form not loading? <a href={formUrl} target="_blank" rel="noopener">Open it in a new tab</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--color-primary);
    padding: var(--spacing-xl) 0;
  }

  .page-header h1 {
    color: var(--color-white);
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: var(--spacing-sm);
  }

  .header-intro {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    max-width: 780px;
    line-height: 1.7;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    align-items: start;
  }

  .pricing-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s;
  }

  .pricing-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .pricing-card.featured {
    border: 2px solid var(--color-primary);
  }

  .pricing-card.featured .pricing-header {
    background: linear-gradient(135deg, #D4742C, #E8943A);
  }

  .pricing-card.featured .pricing-header h3,
  .pricing-card.featured .pricing-header .price,
  .pricing-card.featured .pricing-header .price-note {
    color: var(--color-white);
  }

  .pricing-header {
    padding: var(--spacing-lg);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .pricing-header h3 {
    font-size: 1.35rem;
    margin-bottom: var(--spacing-sm);
  }

  .price {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-primary);
  }

  .price-note {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-top: 0.25rem;
  }

  .pricing-body {
    padding: var(--spacing-lg);
  }

  .pricing-body ul,
  .terms-list {
    list-style: none;
    padding: 0;
  }

  .pricing-body ul li,
  .terms-list li {
    padding: 0.375rem 0 0.375rem 1.25rem;
    font-size: 0.95rem;
    color: var(--color-text);
    position: relative;
  }

  .pricing-body ul li::before,
  .terms-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .terms-list {
    max-width: 780px;
  }

  .terms-list li {
    font-size: 1rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .need-card {
    text-align: center;
  }

  .need-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: rgba(42, 123, 155, 0.1);
    color: var(--color-secondary);
    border-radius: 8px;
    margin: 0 auto var(--spacing-sm);
  }

  .need-card h3 {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-xs);
  }

  .need-card p {
    font-size: 0.95rem;
    color: var(--color-text-light);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--spacing-2xl);
    align-items: start;
  }

  .form-copy p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  .form-embed {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--spacing-sm);
    box-shadow: var(--shadow-sm);
  }

  .form-embed iframe {
    width: 100%;
    height: 1240px;
    border: 0;
    border-radius: 8px;
    background: white;
  }

  .form-fallback {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-top: var(--spacing-sm);
    text-align: center;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .pricing-grid,
    .needs-grid,
    .form-grid {
      grid-template-columns: 1fr;
    }

    .form-grid {
      gap: var(--spacing-lg);
    }

    .form-embed iframe {
      height: 1340px;
    }
  }
</style>
